{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://password-health.local/schemas/agent-response.schema.json",
  "title": "PasswordHealthAgentResponse",
  "type": "object",
  "required": ["score", "status", "guidance"],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": ["HEALTHY", "OKAY", "CRITICAL"]
    },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["priorityRank", "title", "detail", "tone"],
        "properties": {
          "priorityRank": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "detail": {
            "type": "string",
            "minLength": 8,
            "maxLength": 400
          },
          "tone": {
            "type": "string",
            "const": "encouraging"
          }
        },
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 400
    }
  },
  "additionalProperties": false
}
